msgstr "最初のページ"

#: front/search.php
msgid "Previous page"
msgstr "前のページ"

#: front/search.php
msgid "Next page"
msgstr "次のページ"

#: front/search.php
msgid "Last page"
msgstr "最終ページ"

#: templates/search.html.twig
msgid "Not fully counted yet: open the tab to count it"
msgstr "カウントは不完全です。タブを開くと、再カウントします。"
